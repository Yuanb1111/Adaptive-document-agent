# Execution and privacy
EXECUTION_MODE=auto
LOCAL_ONLY=false
PUBLIC_DEPLOYMENT=false

# Default LLM route
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0

# Optional stage-specific model overrides
LLM_DISCOVERY_MODEL=
LLM_SEMANTIC_MODEL=
LLM_EXTRACTION_MODEL=
LLM_PLANNER_MODEL=
LLM_VISION_MODEL=
LLM_INSIGHT_MODEL=
LLM_REPORT_MODEL=

# Provider-specific keys (never commit real values)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Runtime
LOG_LEVEL=INFO
CACHE_DIR=.adaptive_document_cache
MAX_UPLOAD_MB=200
