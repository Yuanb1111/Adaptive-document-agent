# Execution and privacy
EXECUTION_MODE=auto
LOCAL_ONLY=false
PUBLIC_DEPLOYMENT=false

# Default LLM route
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0
# Independent cloud discovery chunks: 1-4 concurrent calls (local models stay serial).
LLM_DISCOVERY_WORKERS=4
# Cloud concurrent discovery input budget per request (local/stateful clients keep 6000).
LLM_DISCOVERY_CHUNK_TOKENS=12000
# Direct DeepSeek supported models only: disabled | enabled | provider_default.
# Affects discovery only; analysis/planning stages retain their model defaults.
LLM_DISCOVERY_THINKING=disabled
# Selectors, bounded repairs and validated-summary/report/layout writing:
# reduced | provider_default. Scoring, insights and analytical topics keep deep reasoning.
LLM_SIMPLE_TASK_REASONING=reduced
# Parallel semantic batches (24-128); larger batches repeat shared context less.
LLM_SEMANTIC_BATCH_SIZE=96
# Estimated CNY costs: range | peak | off_peak. Explicit bands are assumptions.
# range avoids guessing the provider's holiday schedule. This is not a bill.
LLM_DEEPSEEK_PRICE_BAND=range

# Optional stage-specific model overrides
LLM_DISCOVERY_MODEL=
LLM_SEMANTIC_MODEL=
LLM_EXTRACTION_MODEL=
LLM_PLANNER_MODEL=
LLM_VISION_MODEL=
LLM_INSIGHT_MODEL=
LLM_REPORT_MODEL=
LLM_PRESENTATION_MODEL=

# Provider-specific keys (never commit real values)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Runtime
LOG_LEVEL=INFO
CACHE_DIR=.adaptive_document_cache
MAX_UPLOAD_MB=200
# Server-local PPT rendered QA (required for verified PowerPoint export).
# auto: explicit Artifact configuration if present, otherwise installed LibreOffice.
# Streamlit Cloud installs LibreOffice using packages.txt; no desktop paths needed.
PPTX_QA_BACKEND=auto
# Optional Linux override (normally discovered on PATH):
# PPTX_QA_LIBREOFFICE=/usr/bin/libreoffice
# Optional Artifact backend (existing desktop setups):
# Administrator-supplied ABSOLUTE LOCAL paths; no cloud rendering fallback.
# PPTX_QA_NODE=C:/path/to/node.exe
# PPTX_QA_ARTIFACT_MODULE=C:/path/to/@oai/artifact-tool/dist/artifact_tool.mjs
# Change this when updating installed fonts, or restart the UI to clear its cache.
# PPTX_QA_FONT_REVISION=1
